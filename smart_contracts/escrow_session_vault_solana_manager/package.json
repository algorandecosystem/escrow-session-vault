{
  "name": "escrow-session-vault-solana-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "anchor build --no-idl -- --tools-version v1.52 && anchor idl build -o target/idl/escrow_session_vault_solana_manager.json",
    "build:local": "anchor build -- --features local-testing",
    "check-types": "tsc --noEmit",
    "test:local": "SOLANA_LOCAL_TEST=true ts-node -r dotenv/config run-lifecycle.ts",
    "deploy:devnet": "DOTENV_CONFIG_PATH=../../.env.testnet ts-node -r dotenv/config deploy.ts",
    "test:devnet": "DOTENV_CONFIG_PATH=../../.env.testnet ts-node -r dotenv/config run-lifecycle.ts",
    "test": "anchor test -- --features local-testing"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bip39": "3.1.0",
    "bs58": "6.0.0",
    "dotenv": "16.4.7",
    "ed25519-hd-key": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
