# Network (testnet defaults)
ALGOD_TOKEN=
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=
INDEXER_TOKEN=
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=

# USDC ASA id (compile-time template var)
# TestNet USDC: 10458941
# MainNet USDC: 31566704
TMPL_USDC_ASSET_ID=10458941

# Admin / deployer account used by: algorand.account.fromEnvironment('DEPLOYER')
# Replace with your real 25-word mnemonic
DEPLOYER_MNEMONIC=[replace]

# Native Falcon-1024 PQ 25-word mnemonics. Payer needs USDC; payee must be opted into the configured USDC ASA.
# Set the expected derived addresses as a safety check before submitting any transaction.
PAYER_MNEMONIC=[replace]
PAYER_ADDRESS=[replace]
PAYER_PQ_PASSPHRASE=
PAYEE_MNEMONIC=[replace]
PAYEE_ADDRESS=[replace]
PAYEE_PQ_PASSPHRASE=

